{
  "manifest_version": 3,
  "name": "Vortex Search",
  "version": "0.4.0",
  "description": "Search your Vortex knowledge base from anywhere in the browser.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://vortex-rho-cyan.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Search Vortex (Alt+Shift+V)" },
  "side_panel": { "default_path": "panel.html" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Search your knowledge base"
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
